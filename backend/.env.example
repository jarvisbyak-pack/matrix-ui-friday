NODE_ENV=development
PORT=3001
TRUST_PROXY=false
FRONTEND_ORIGIN=http://localhost:3000,https://jarvisbyak-pack.github.io
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friday
DB_POOL_MAX=10
WORKER_POLL_MS=1000
WORKER_STALE_TASK_MS=300000
WORKER_CONCURRENCY=3
AUTH_SESSION_DAYS=7
ALLOW_PUBLIC_REGISTRATION=true
ALLOWED_USER_EMAILS=
OWNER_EMAILS=
FILE_STORAGE_DIR=./storage
FILE_MAX_BYTES=10485760
CODE_WORKSPACE_ROOT=.
CODE_ALLOWED_COMMANDS=npm test,npm run build
CODE_COMMAND_TIMEOUT_MS=120000
CODE_MAX_OUTPUT_BYTES=500000
FRIDAY_ALLOW_CODE_EXECUTION=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.6
ALLOWED_AI_MODELS=
ALLOW_CROSS_PROVIDER_ROUTING=false
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOW_SHARED_TOKEN=false
GITHUB_ALLOWED_REPOS=
TOOL_ENCRYPTION_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_SEARCH_TIMEOUT_MS=20000
FRIDAY_ALLOW_GITHUB_MUTATIONS=false

# OAuth provider configuration
OAUTH_FRONTEND_ORIGIN=https://jarvisbyak-pack.github.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.example.com/api/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-backend.example.com/api/auth/github/callback
